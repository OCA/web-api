<odoo>
    <record id="group_openapi_doc_viewer" model="res.groups">
        <field name="name">API docs: viewer</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field
            name="comment"
        >Default group allowed to see OpenAPI docs. Sources and categories can require other groups.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_openapi_doc_viewer'))]" />
    </record>
</odoo>
