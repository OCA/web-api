    <record id="endpoint_log_action" model="ir.actions.act_window">
        <field name="name">Endpoint Logs</field>
        <field name="res_model">api.log</field>
        <field name="domain">[("collection_model", "=", "endpoint.endpoint")]</field>
        <field name="view_mode">list,form</field>
